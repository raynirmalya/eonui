{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@mystique/components": ["./packages/mystique-components/src/index"],
      "@mystique/core": ["./packages/mystique-core/src/index"],
      "@mystique/canvas": ["./packages/mystique-canvas/src/index"],
      "@mystique/svg": ["./packages/mystique-svg/src/index"]
    }
  }
}
