{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "collection": "./dist/collection/collection-manifest.json",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "stencil build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jarvis/a11y": "workspace:*",
    "@jarvis/icons": "workspace:*",
    "@jarvis/i18n": "workspace:*",
    "@jarvis/styles": "workspace:*",
    "@jarvis/tokens": "workspace:*",
    "@jarvis/utils": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.20.0"
  }
}
