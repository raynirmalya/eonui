    "feedback": {
      "success": { "$value": "{base.color.success.500}", "$type": "color" },
      "warning": { "$value": "{base.color.warning.500}", "$type": "color" },
      "danger": { "$value": "{base.color.danger.500}", "$type": "color" }
    },
    "chart": {
      "series1": { "$value": "{base.color.brand.600}", "$type": "color" },
      "series2": { "$value": "{base.color.brand.500}", "$type": "color" },
      "series3": { "$value": "{base.color.success.500}", "$type": "color" },
      "series4": { "$value": "{base.color.warning.500}", "$type": "color" },
      "grid": { "$value": "{base.color.neutral.100}", "$type": "color" },
      "axis": { "$value": "{base.color.neutral.700}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "paddingX": { "$value": "{base.space.5}", "$type": "dimension" },
      "paddingY": { "$value": "{base.space.3}", "$type": "dimension" },
      "radius": { "$value": "{base.radius.md}", "$type": "dimension" },
      "shadow": { "$value": "{semantic.shadow.soft}", "$type": "shadow" }
    },
    "field": {
      "height": { "$value": "3rem", "$type": "dimension" },
      "radius": { "$value": "{base.radius.md}", "$type": "dimension" },
      "paddingX": { "$value": "{base.space.4}", "$type": "dimension" }
    },
    "surface": {
      "padding": { "$value": "{base.space.5}", "$type": "dimension" }
    },
    "card": {
      "padding": { "$value": "{base.space.6}", "$type": "dimension" },
      "radius": { "$value": "{base.radius.xl}", "$type": "dimension" }
    },
    "dialog": {
      "radius": { "$value": "{base.radius.xl}", "$type": "dimension" },
      "padding": { "$value": "{base.space.6}", "$type": "dimension" }
    },
    "drawer": {
      "padding": { "$value": "{base.space.6}", "$type": "dimension" },
      "width": { "$value": "28rem", "$type": "dimension" }
    },
    "tooltip": {
      "radius": { "$value": "{base.radius.sm}", "$type": "dimension" },
      "paddingX": { "$value": "{base.space.2}", "$type": "dimension" },
      "paddingY": { "$value": "{base.space.1}", "$type": "dimension" }
    },
    "toast": {
      "radius": { "$value": "{base.radius.xl}", "$type": "dimension" },
      "padding": { "$value": "{base.space.5}", "$type": "dimension" }
    },
    "layout": {
      "gap": { "$value": "{base.space.5}", "$type": "dimension" },
      "sectionGap": { "$value": "{base.space.10}", "$type": "dimension" }
    }
  },
