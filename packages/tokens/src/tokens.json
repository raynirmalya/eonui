      "easing": {
        "premium": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
        "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" }
      },
      "blur": {
        "overlay": { "$value": "18px", "$type": "dimension" }
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{base.color.neutral.0}", "$type": "color" },
      "sunken": { "$value": "{base.color.neutral.50}", "$type": "color" },
      "raised": { "$value": "{base.color.neutral.0}", "$type": "color" },
      "elevated": { "$value": "rgba(255, 255, 255, 0.78)", "$type": "color" },
      "overlay": { "$value": "rgba(9, 17, 28, 0.52)", "$type": "color" },
      "glass": { "$value": "rgba(255, 255, 255, 0.66)", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{base.color.neutral.900}", "$type": "color" },
      "secondary": { "$value": "{base.color.neutral.500}", "$type": "color" },
      "inverse": { "$value": "{base.color.neutral.0}", "$type": "color" },
      "muted": { "$value": "{base.color.neutral.700}", "$type": "color" }
    },
    "action": {
      "primaryBg": { "$value": "{base.color.brand.600}", "$type": "color" },
      "primaryBgHover": { "$value": "{base.color.brand.700}", "$type": "color" },
      "primaryText": { "$value": "{base.color.neutral.0}", "$type": "color" },
      "secondaryBg": { "$value": "{base.color.neutral.25}", "$type": "color" },
      "secondaryText": { "$value": "{base.color.neutral.900}", "$type": "color" },
      "glow": { "$value": "{base.color.accent.glow}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "rgba(16, 24, 40, 0.08)", "$type": "color" },
      "subtle": { "$value": "rgba(16, 24, 40, 0.05)", "$type": "color" },
      "strong": { "$value": "rgba(52, 64, 84, 0.24)", "$type": "color" },
      "focus": { "$value": "{base.color.brand.500}", "$type": "color" }
    },
    "shadow": {
      "soft": { "$value": "{base.shadow.soft}", "$type": "shadow" },
      "elevated": { "$value": "{base.shadow.elevated}", "$type": "shadow" },
      "glass": { "$value": "{base.shadow.glass}", "$type": "shadow" }
    },
    "motion": {
      "micro": { "$value": "{base.motion.duration.micro}", "$type": "duration" },
      "ui": { "$value": "{base.motion.duration.ui}", "$type": "duration" },
      "complex": { "$value": "{base.motion.duration.complex}", "$type": "duration" },
      "ease": { "$value": "{base.motion.easing.premium}", "$type": "cubicBezier" }
