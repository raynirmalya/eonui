    "light": {
      "color": {
        "surface.canvas": { "$value": "{semantic.surface.canvas}", "$type": "color" },
        "surface.raised": { "$value": "{semantic.surface.raised}", "$type": "color" },
        "text.primary": { "$value": "{semantic.text.primary}", "$type": "color" },
        "text.secondary": { "$value": "{semantic.text.secondary}", "$type": "color" },
        "border.default": { "$value": "{semantic.border.default}", "$type": "color" },
        "chart.axis": { "$value": "{semantic.chart.axis}", "$type": "color" },
        "chart.grid": { "$value": "{semantic.chart.grid}", "$type": "color" }
