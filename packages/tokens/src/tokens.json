        "text": {
          "primary": { "$value": "#1c1b1f", "$type": "color" },
          "secondary": { "$value": "#49454f", "$type": "color" }
        },
        "action": {
          "primaryBg": { "$value": "#6750a4", "$type": "color" },
          "primaryBgHover": { "$value": "#4f378b", "$type": "color" }
        },
        "border": {
          "default": { "$value": "rgba(121, 116, 126, 0.18)", "$type": "color" },
