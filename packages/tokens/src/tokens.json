{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "meta": {
    "name": "Jarvis Tokens",
    "version": "0.1.0"
  },
  "base": {
    "color": {
      "neutral": {
        "0": { "$value": "#ffffff", "$type": "color" },
        "25": { "$value": "#fbfcfe", "$type": "color" },
        "50": { "$value": "#f4f6fa", "$type": "color" },
        "100": { "$value": "#e7ebf2", "$type": "color" },
        "200": { "$value": "#d7dee8", "$type": "color" },
        "500": { "$value": "#667085", "$type": "color" },
        "700": { "$value": "#344054", "$type": "color" },
        "850": { "$value": "#182230", "$type": "color" },
        "900": { "$value": "#101828", "$type": "color" }
      },
      "brand": {
        "400": { "$value": "#4f7cff", "$type": "color" },
        "500": { "$value": "#325dff", "$type": "color" },
        "600": { "$value": "#2446d8", "$type": "color" },
        "700": { "$value": "#1d379f", "$type": "color" }
      },
      "accent": {
        "emerald": { "$value": "#0f8f7b", "$type": "color" },
        "violet": { "$value": "#6e56cf", "$type": "color" },
        "glow": { "$value": "rgba(50, 93, 255, 0.20)", "$type": "color" }
      },
      "success": {
        "500": { "$value": "#15803d", "$type": "color" }
      },
      "warning": {
        "500": { "$value": "#b45309", "$type": "color" }
      },
      "danger": {
        "500": { "$value": "#b91c1c", "$type": "color" }
      }
    },
    "space": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "0.5rem", "$type": "dimension" },
      "md": { "$value": "0.75rem", "$type": "dimension" },
      "lg": { "$value": "0.875rem", "$type": "dimension" },
      "xl": { "$value": "1.125rem", "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" }
    },
    "font": {
      "family": {
        "sans": { "$value": "'Sora', 'IBM Plex Sans', 'Segoe UI', sans-serif", "$type": "fontFamily" },
        "body": { "$value": "'IBM Plex Sans', 'Segoe UI', sans-serif", "$type": "fontFamily" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" }
      },
      "size": {
        "caption": { "$value": "0.75rem", "$type": "fontSize" },
        "body": { "$value": "0.95rem", "$type": "fontSize" },
        "subheading": { "$value": "1.125rem", "$type": "fontSize" },
        "heading": { "$value": "1.75rem", "$type": "fontSize" },
        "display": { "$value": "3.5rem", "$type": "fontSize" }
      },
      "lineHeight": {
        "caption": { "$value": "1.3", "$type": "number" },
        "body": { "$value": "1.65", "$type": "number" },
        "heading": { "$value": "1.12", "$type": "number" },
        "display": { "$value": "0.98", "$type": "number" }
      },
      "letterSpacing": {
        "tight": { "$value": "-0.03em", "$type": "dimension" },
        "heading": { "$value": "-0.04em", "$type": "dimension" },
        "wide": { "$value": "0.08em", "$type": "dimension" }
      }
    },
    "shadow": {
      "soft": { "$value": "0 18px 50px rgba(16, 24, 40, 0.08)", "$type": "shadow" },
      "elevated": { "$value": "0 24px 80px rgba(16, 24, 40, 0.14)", "$type": "shadow" },
      "glass": { "$value": "0 10px 30px rgba(16, 24, 40, 0.10)", "$type": "shadow" }
    },
    "motion": {
