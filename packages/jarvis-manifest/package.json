{
  "name": "@jarvis/manifest",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "generated"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/generate.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jarvis/tokens": "workspace:*",
    "@jarvis/utils": "workspace:*"
  }
}
