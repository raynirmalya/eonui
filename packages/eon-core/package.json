{
  "name": "@eonui/core",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "collection": "./dist/collection/collection-manifest.json",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "stencil build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@eonui/a11y": "workspace:*",
    "@eonui/i18n": "workspace:*",
    "@eonui/icons": "workspace:*",
    "@eonui/styles": "workspace:*",
    "@eonui/tokens": "workspace:*",
    "@eonui/utils": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.20.0",
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.1"
  }
}
